<div class="form-group msg-form">
  <%= form_with(model: [@single_room, @message], remote: true, class: "flex items-center gap-2 w-full") do |f| %>
    <%= f.text_field :body, id: "chat-text",
                     class: "flex-1 px-3 py-2 rounded-lg bg-gray-700 text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500",
                     autocomplete: "off", placeholder: "Type your message..." %>
    <%= f.submit "Send", data: { disable_with: false },
                         class: "px-4 py-2 rounded-lg bg-green-600 text-white font-semibold hover:bg-green-700 transition" %>
  <% end %>
</div>
