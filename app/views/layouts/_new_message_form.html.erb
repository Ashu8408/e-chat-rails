<div data-controller="reset-form">
  <%= form_with(model: [@single_room, @message], remote: true, class: "flex items-center gap-2 w-full",
        data: { action: "turbo:submit-end->reset-form#reset", "reset-form-target": "form" } ) do |f| %>
    <%= f.text_field :body, id: "chat-text", class: "flex-1 px-5 py-2 rounded-lg bg-gray-700 text-white", placeholder: "Type your message..." %>
    <%= f.submit "Send", class: "px-4 py-2 bg-green-600 text-white rounded-lg" %>
  <% end %>
</div>