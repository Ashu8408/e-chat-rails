<%= form_with(model: @room, remote: true, class: "flex gap-2 items-center w-full") do |f| %>
  <%= f.text_field :name,
      class: "flex-1 px-3 py-2 rounded-lg bg-gray-700 text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500",
        autocomplete: "off",
        placeholder: "Enter room name" %>

  <%= f.submit "Create",
        data: { disable_with: false },
        class: "px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition" %>
<% end %>
