<div id="chatroom_container"
     class="flex bg-gray-900 text-gray-200 h-screen">

  <!-- LEFT SIDE PANEL -->
  <div id="side_panel"
       class="w-1/3 p-4 bg-gray-800 overflow-y-auto space-y-4">

    <h5 class="text-lg font-semibold"><%= current_user.email %></h5>

    <h4 class="text-xl font-bold border-b border-gray-700 pb-1">Users</h4>
    <%= turbo_stream_from "users" %>

    <div id="users" class="space-y-2">
      <%= render @users %>
    </div>

    <h4 class="text-xl font-bold border-b border-gray-700 pb-1 mt-4">Rooms</h4>
    <%= turbo_stream_from "rooms" %>

    <div class="mb-3">
      <%= render 'layouts/new_room_form' %>
    </div>

    <div id="rooms" class="space-y-2">
      <%= render @rooms %>
    </div>
  </div>



</div>
