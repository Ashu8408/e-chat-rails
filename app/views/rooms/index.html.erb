<div id="chatroom_container" class="flex bg-gray-900 text-gray-200 h-screen">
  <!-- LEFT SIDE PANEL -->
  <div id="left_side_panel" class="w-1/3 p-4 bg-gray-800 overflow-y-auto space-y-4">
    <h5 class="text-lg font-semibold"><%= current_user.email %></h5>
    <h4 class="text-xl font-bold border-b border-gray-700 pb-1">Users</h4>
    <%= turbo_stream_from "users" %>
    <!-- Users list -->
    <div id="users" class="space-y-2">
      <%= render @users %>
    </div>
    <!-- Rooms list -->
    <h4 class="text-xl font-bold border-b border-gray-700 pb-1 mt-4">Rooms</h4>
    <%= turbo_stream_from "rooms" %>
    <!-- New room form -->
    <div class="mb-3">
      <%= render 'layouts/new_room_form' %>
    </div>
    <div id="rooms" class="space-y-2">
      <%= render @rooms %>
    </div>
  </div>

  <!-- RIGHT ROOM CHAT PANEL -->
  <div id="right_room_container" class="w-2/3 bg-gray-900 p-4 overflow-y-auto">
    <% if @single_room %> 
      <div id="single_room">
        <h4 id=chat-room-heading class="text-center text-2xl mb-4"><%= @user&.email || @single_room.name %></h4>
        <%= turbo_stream_from @single_room %>
        <div id="messages" class="space-y-3 max-h-full overflow-y-auto border border-gray-700 p-4 rounded-lg bg-gray-800">
          <%= render @messages %>
          <div class="pt-2">
            <%= render 'layouts/new_message_form' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
