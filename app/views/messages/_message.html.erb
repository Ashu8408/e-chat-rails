<div class="cont-<%=message.user.id%>">
  <div class="message-box msg-<%= message.user.id %>">
    <% unless message.room.is_private %>
      <h6 class="username"> <%= message.user.email.split('@').first %> </h6>
    <% end %>
    <div id="message-body" class="px-2 mb-2"><%= message.body %></div>
  </div>
</div>