<div class="flex w-full my-2 cont-<%= message.user_id %> <%= message.user_id == @viewer_id ? 'justify-end' : 'justify-start' %>">
  <div id="message-box" class="<%= message.user_id == @viewer_id ? 'bg-green-600 text-white' : 'bg-blue-800 text-white' %> rounded-xl px-4 py-2 shadow-md max-w-[80%] msg-<%= message.user.id %>">
    <% unless message.room.is_private %>
      <h6 id="username" class="text-sm font-semibold mb-1 text-blue-300">
        <%= message.user.email.split('@').first %>
      </h6>
    <% end %>
    <div id="message-body" class="text-base">
      <%= message.body %>
    </div>
  </div>
</div>



