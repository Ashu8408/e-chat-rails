<h1 class="p-2 text-3xl font-bold mb-6">location: app/views/pages/home.html.erb</h1>

<% if current_user %>
  <%= link_to "Start Chatting",
      rooms_path,
      class: "inline-block bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded-lg transition mr-3" %>

  <%= button_to "Logout",
      destroy_user_session_path,
      method: :delete,
      class: "inline-block bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded-lg transition mt-2" %>
<% else %>
  <div class="p-4 bg-blue-200 rounded-lg flex space-x-4">
    <%= link_to "Login",
        new_user_session_path,
        class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition" %>

    <%= link_to "Sign Up",
        new_user_registration_path,
        class: "px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition" %>
  </div>
<% end %>
